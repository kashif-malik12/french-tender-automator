# ==============================================================================
# French Tender Automator — Environment Configuration Template
# Copy to .env and fill in strong secrets before running Docker Compose.
# ==============================================================================

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=tender_user
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=french_tenders
DATABASE_URL=postgresql+psycopg://tender_user:change_me_strong_db_password@db:5432/french_tenders

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- LLM & Embedding Configuration ---
# LLM_PROVIDER: openai | gemini | heuristic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Authentication & Security ---
# Required to protect the Web UI and API endpoints (JWT login + HTTP Basic Auth)
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASS=change_me_strong_app_password
JWT_SECRET_KEY=change_me_to_a_random_64_char_secret_key_for_jwt_signing
JWT_EXPIRE_MINUTES=720

# --- BOAMP Veille Schedule (UTC) ---
BOAMP_CRON_HOUR=7
BOAMP_CRON_MINUTE=0
BOAMP_DEFAULT_LIMIT=25

# --- Default Company Filter Seed (TRADISTER SASU) ---
DEFAULT_COMPANY_NAME=TRADISTER SASU
DEFAULT_COMPANY_PRESIDENT=Bisma Kashif
DEFAULT_COMPANY_SIREN=988318945
DEFAULT_COMPANY_SIRET=98831894500017
DEFAULT_COMPANY_TVA=FR42988318945
DEFAULT_COMPANY_NAF=62.02A
DEFAULT_COMPANY_ADDRESS=11 Rue du Château d'Eau, App 132, 91130 Ris-Orangis, France
DEFAULT_DEPARTMENTS=91,75,92,93,94,77,78,95
DEFAULT_CPV_CODES=72000000,72200000,72300000,72500000,72600000,48000000
DEFAULT_KEYWORDS=infogérance,cloud,cybersécurité,support informatique,helpdesk,maintenance applicative,TMA,MCO,développement logiciel,systèmes d'information,ITSM,managed services
DEFAULT_MIN_TARGET_AMOUNT=10000
DEFAULT_MAX_TARGET_AMOUNT=500000

# --- Reverse Proxy & Ports (Isolated from host ports 80/443 by default) ---
# On a dedicated VPS, set SITE_ADDRESS=votre-domaine.fr, CADDY_BIND_IP=0.0.0.0,
# APP_HTTP_PORT=80, APP_HTTPS_PORT=443
SITE_ADDRESS=:80
CADDY_BIND_IP=127.0.0.1
APP_HTTP_PORT=8098
APP_HTTPS_PORT=8448

# --- Storage Paths (inside backend/worker containers) ---
DATA_DIR=/app/data

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_APP_NAME=Marchés Publics AI
